{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Database": {
    "PrimaryConnectionString": "Server=localhost;Database=ApiGateway;User Id=sa;Password=DevPass123!;TrustServerCertificate=true;Encrypt=false",
    "ReadReplicaConnectionString": "",
    "ConnectionLifetimeSeconds": 300,
    "DefaultCommandTimeoutSeconds": 30,
    "MaxRetries": 3,
    "RunMigrationsOnStartup": true
  },
  "Audit": {
    "FallbackQueuePath": "/tmp/apigateway-audit-fallback",
    "BatchSize": 500,
    "FlushIntervalMs": 250,
    "ChannelCapacity": 10000,
    "FallbackRecoveryIntervalSeconds": 30
  },
  "Secrets": {
    "Enabled": false,
    "Region": "us-east-1",
    "JwtSigningKeySecretName": "apigateway/jwt-signing-key",
    "DbCredentialsSecretName": "apigateway/db-credentials"
  },
  "Jwt": {
    "SigningKey": "dev-signing-key-min-32-characters-long-for-hmac-sha256",
    "Issuer": "api-gateway-dev",
    "Audience": "api-gateway"
  },
  "AllowedHosts": "*"
}
